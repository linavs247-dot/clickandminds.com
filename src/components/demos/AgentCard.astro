---
// The AI Employee Gallery card, Phase 3 version: an always-on ambient
// "workflow in motion" feel (sequential pulsing feature dots, a rotating
// notification line cycling through fake real-time events) plus a hover
// state that reveals one extra insight line. All CSS keyframe driven, no
// JS/React island needed for four decorative, non-interactive cards.
import Badge from "../ui/Badge.astro";

interface Props {
  tag: string;
  name: string;
  description: string;
  status?: "active" | "working";
  features: string[];
  liveMessages: string[];
  insight: string;
  class?: string;
}

const {
  tag,
  name,
  description,
  status = "active",
  features,
  liveMessages,
  insight,
  class: className = "",
} = Astro.props;
---

<div
  class={`agent-card group rounded-3xl border border-[var(--card-border)] bg-[var(--card-bg)] p-7 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1.5 hover:scale-[1.01] hover:border-neon-purple/60 hover:brightness-105 hover:shadow-[0_0_40px_-12px_rgba(143,92,255,0.6)] ${className}`}
>
  <div class="flex items-start justify-between gap-3">
    <div>
      <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-[var(--eyebrow-fg)]">{tag}</p>
      <h3 class="mt-2 font-display text-xl font-bold text-[var(--fg)]">{name}</h3>
    </div>
    <Badge variant={status === "active" ? "status-active" : "status-working"}>
      {status === "active" ? "Active" : "Working…"}
    </Badge>
  </div>

  <p class="mt-4 text-sm leading-relaxed text-[var(--fg-muted)]">{description}</p>

  <div class="mt-6 space-y-2.5 rounded-2xl border border-purple-primary/10 bg-purple-primary/5 p-4 dark:border-white/10 dark:bg-navy-dark/40">
    {features.map((feature, i) => (
      <div class="flex items-center gap-2.5 text-[13px] text-[var(--fg)]/80">
        <span
          class="agent-dot h-1.5 w-1.5 shrink-0 rounded-full bg-lime"
          style={`animation-delay:${i * 0.3}s`}
          aria-hidden="true"
        />
        {feature}
      </div>
    ))}

    <div class="notif-stack relative mt-1 h-5 overflow-hidden border-t border-[var(--divider)] pt-2 font-mono text-[10px] text-[var(--eyebrow-fg)]">
      {liveMessages.map((message, i) => (
        <span class={`notif-slot notif-slot-${i + 1} absolute inset-x-0 top-2`}>
          &gt; {message}
        </span>
      ))}
    </div>
  </div>

  <div class="agent-insight grid min-h-0 grid-rows-[0fr] opacity-0 transition-all duration-300 group-hover:mt-3 group-hover:grid-rows-[1fr] group-hover:opacity-100">
    <p class="min-h-0 overflow-hidden text-[12.5px] leading-relaxed text-[var(--eyebrow-fg)]">{insight}</p>
  </div>
</div>

<style>
  @keyframes agent-dot-pulse {
    0%,
    100% {
      opacity: 0.4;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.4);
    }
  }

  .agent-dot {
    animation: agent-dot-pulse 2.4s ease-in-out infinite;
  }

  @keyframes notif-slot-1-cycle {
    0%,
    4% {
      opacity: 0;
      transform: translateY(4px);
    }
    8%,
    29% {
      opacity: 1;
      transform: translateY(0);
    }
    33%,
    100% {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
  @keyframes notif-slot-2-cycle {
    0%,
    37% {
      opacity: 0;
      transform: translateY(4px);
    }
    41%,
    62% {
      opacity: 1;
      transform: translateY(0);
    }
    66%,
    100% {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
  @keyframes notif-slot-3-cycle {
    0%,
    70% {
      opacity: 0;
      transform: translateY(4px);
    }
    74%,
    95% {
      opacity: 1;
      transform: translateY(0);
    }
    99%,
    100% {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  .notif-slot {
    opacity: 0;
  }
  .notif-slot-1 {
    animation: notif-slot-1-cycle 9s ease-in-out infinite;
  }
  .notif-slot-2 {
    animation: notif-slot-2-cycle 9s ease-in-out infinite;
  }
  .notif-slot-3 {
    animation: notif-slot-3-cycle 9s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .agent-dot,
    .notif-slot-1,
    .notif-slot-2,
    .notif-slot-3 {
      animation: none;
    }
    .notif-slot-1 {
      opacity: 1;
    }
  }
</style>
