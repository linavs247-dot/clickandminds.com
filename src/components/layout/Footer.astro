---
import Button from "../ui/Button.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { GOOGLE_FORM_URL } from "../../lib/constants";
import { defaultLocale, useTranslations, type Locale } from "../../i18n/ui";

const locale = (Astro.currentLocale as Locale | undefined) ?? defaultLocale;
const t = useTranslations(locale);

const findMeLinks = [
  {
    label: t.footer.linkedin,
    href: "https://www.linkedin.com/in/lina-smith/",
    external: true,
    icon: "linkedin" as const,
  },
  {
    label: t.footer.newsletter,
    href: "https://clickandminds.beehiiv.com/",
    external: true,
    icon: "newsletter" as const,
  },
  {
    label: t.footer.email,
    href: "mailto:hey@clickandminds.com",
    external: false,
    icon: "email" as const,
  },
];
---

<footer class="relative overflow-hidden bg-dark-deep px-6 py-16 text-white-soft">
  <div class="footer-glow pointer-events-none absolute inset-x-0 bottom-0 flex justify-center" aria-hidden="true">
    <div class="footer-glow-beam"></div>
  </div>

  <div class="relative mx-auto max-w-6xl">
    <div class="grid grid-cols-1 gap-10 border-b border-white/10 pb-10 sm:grid-cols-2 md:grid-cols-5">
      <div class="md:col-span-2">
        <p class="font-display text-xl font-extrabold tracking-tight">
          Click &amp; Minds<span class="text-electric-pink">.</span>
        </p>
        <p class="mt-3 max-w-xs text-sm text-white-soft/65">
          {t.footer.tagline}
        </p>
      </div>

      <div>
        <p class="mb-4 font-mono text-[10px] uppercase tracking-[0.15em] text-lime">{t.footer.services}</p>
        <nav class="flex flex-col gap-2 text-sm text-white-soft/70">
          <a href={getRelativeLocaleUrl(locale, "/")} class="w-fit transition-colors hover:text-lime">{t.nav.aiAgents}</a>
          <a href={getRelativeLocaleUrl(locale, "/websites")} class="w-fit transition-colors hover:text-lime">{t.nav.websites}</a>
          <a href={getRelativeLocaleUrl(locale, "/portfolio")} class="w-fit transition-colors hover:text-lime">{t.nav.portfolio}</a>
        </nav>
      </div>

      <div>
        <p class="mb-4 font-mono text-[10px] uppercase tracking-[0.15em] text-lime">{t.footer.findMe}</p>
        <nav class="flex flex-col gap-2.5 text-sm text-white-soft/70">
          {findMeLinks.map((link) => (
            <a
              href={link.href}
              class="group flex w-fit items-center gap-1.5 transition-colors hover:text-lime"
              {...(link.external ? { target: "_blank", rel: "noopener" } : {})}
            >
              <span class="inline-flex h-4 w-4 items-center justify-center text-white-soft/50 transition-colors group-hover:text-lime" aria-hidden="true">
                {link.icon === "linkedin" && (
                  <svg viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5">
                    <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.64h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.6c0-1.34-.02-3.06-1.87-3.06-1.87 0-2.16 1.46-2.16 2.96V21h-4V9Z" />
                  </svg>
                )}
                {link.icon === "newsletter" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5">
                    <path d="M12 3a5 5 0 0 0-5 5v3.2c0 .6-.2 1.2-.6 1.7L5 15h14l-1.4-2.1a2.7 2.7 0 0 1-.6-1.7V8a5 5 0 0 0-5-5Z" />
                    <path d="M10 18a2 2 0 0 0 4 0" />
                  </svg>
                )}
                {link.icon === "email" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5">
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="m4 7 8 6 8-6" />
                  </svg>
                )}
              </span>
              {link.label}
              <span class="text-[11px] opacity-0 transition-opacity group-hover:opacity-100" aria-hidden="true">&#8599;</span>
            </a>
          ))}
        </nav>
      </div>

      <div>
        <p class="mb-4 font-mono text-[10px] uppercase tracking-[0.15em] text-lime">{t.footer.getStarted}</p>
        <Button href={GOOGLE_FORM_URL} external variant="ghost" size="md">{t.nav.bookACall}</Button>
      </div>
    </div>

    <div class="flex flex-col gap-2 pt-6 font-mono text-[11px] text-white-soft/50 sm:flex-row sm:items-center sm:justify-between">
      <p>{t.footer.copyright}</p>
    </div>
  </div>
</footer>

<style>
  /*
   * Soft vertical light beam rising from the bottom center of the
   * footer, purple core fading to transparent, with a slow breathing
   * animation (opacity + a slight vertical stretch). Already covered by
   * global.css's blanket prefers-reduced-motion rule (forces all
   * animation-duration to ~0), so no extra handling needed here.
   */
  .footer-glow-beam {
    width: 22rem;
    height: 26rem;
    background: radial-gradient(
      ellipse 50% 100% at 50% 100%,
      rgba(143, 92, 255, 0.55) 0%,
      rgba(143, 92, 255, 0.2) 40%,
      transparent 72%
    );
    filter: blur(30px);
    transform-origin: bottom center;
    animation: footer-glow-breathe 6s ease-in-out infinite;
  }

  @keyframes footer-glow-breathe {
    0%,
    100% {
      opacity: 0.7;
      transform: scaleY(1);
    }
    50% {
      opacity: 1;
      transform: scaleY(1.08);
    }
  }
</style>
