---
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import Button from "../ui/Button.astro";
import LanguageSwitcher from "../ui/LanguageSwitcher.astro";
import { GOOGLE_FORM_URL } from "../../lib/constants";
import { defaultLocale, useTranslations, type Locale } from "../../i18n/ui";
import logoHorizontal from "../../assets/logo-horizontal.png";

interface Props {
  active?: "home" | "websites" | "portfolio";
}

const { active = "home" } = Astro.props;
const locale = (Astro.currentLocale as Locale | undefined) ?? defaultLocale;
const t = useTranslations(locale);

const links = [
  { key: "home" as const, label: t.nav.aiAgents, href: getRelativeLocaleUrl(locale, "/") },
  { key: "websites" as const, label: t.nav.websites, href: getRelativeLocaleUrl(locale, "/websites") },
  { key: "portfolio" as const, label: t.nav.portfolio, href: getRelativeLocaleUrl(locale, "/portfolio") },
];
---

<header id="site-nav" class="fixed inset-x-0 top-0 z-50">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href={getRelativeLocaleUrl(locale, "/")} class="shrink-0">
      <Image src={logoHorizontal} alt="Click & Minds" width={172} height={40} class="h-9 w-auto sm:h-10" />
    </a>

    <div class="hidden items-center gap-8 font-body text-sm font-medium text-[var(--fg)] md:flex">
      {links.map((link) => (
        <a
          href={link.href}
          class="opacity-90 transition-opacity hover:opacity-100 aria-[current=page]:opacity-100 aria-[current=page]:underline aria-[current=page]:decoration-lime aria-[current=page]:underline-offset-4"
          aria-current={active === link.key ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-3 sm:gap-4">
      <div class="hidden items-center gap-4 sm:gap-5 md:flex">
        <LanguageSwitcher />
        <Button href={GOOGLE_FORM_URL} external variant="lime" size="md">{t.nav.bookACall}</Button>
      </div>

      <button
        id="mobile-menu-toggle"
        type="button"
        class="hamburger md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.nav.openMenu}
      >
        <span class="hamburger-bar" aria-hidden="true"></span>
        <span class="hamburger-bar" aria-hidden="true"></span>
        <span class="hamburger-bar" aria-hidden="true"></span>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="mobile-menu md:hidden" aria-hidden="true" inert>
    <nav class="mobile-menu-links" aria-label="Mobile">
      {links.map((link) => (
        <a
          href={link.href}
          class="font-display text-2xl font-semibold text-[var(--fg)] opacity-90 transition-opacity hover:opacity-100 aria-[current=page]:opacity-100 aria-[current=page]:underline aria-[current=page]:decoration-lime aria-[current=page]:underline-offset-4"
          aria-current={active === link.key ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="mobile-menu-footer">
      <div class="flex items-center justify-between">
        <span class="font-body text-sm font-medium" style="color: var(--fg-muted)">{t.nav.language}</span>
        <LanguageSwitcher />
      </div>
      <Button href={GOOGLE_FORM_URL} external variant="lime" size="lg" class="w-full justify-center">
        {t.nav.bookACall}
      </Button>
    </div>
  </div>
</header>

<style>
  /*
   * Always-on translucent glass, so the bar reads clearly over any hero
   * content from the very top of the page (not just once scrolled). The
   * base tint is dark-deep (not flat purple-primary): purple-primary is
   * close enough in lightness to the logo wordmark's dark-purple half
   * that the two collapse into each other at low opacity, making "CLICK"
   * unreadable. dark-deep keeps a purple undertone while staying dark
   * enough for the logo (and body copy) to read clearly against it; the
   * radial glow layered on top supplies the "tinted with brand purple"
   * feel without flattening the whole bar to one mid-purple. `.nav-
   * scrolled` only adds a further intensity bump plus the border, as a
   * subtle depth cue once scrolling starts.
   */
  #site-nav {
    background-color: color-mix(in srgb, var(--color-dark-deep) 55%, transparent);
    background-image: radial-gradient(ellipse 120% 100% at 50% -40%, color-mix(in srgb, var(--color-purple-primary) 40%, transparent) 0%, transparent 70%);
    backdrop-filter: blur(14px);
    transition: background-color 0.3s var(--ease-snap), border-color 0.3s var(--ease-snap);
  }
  #site-nav.nav-scrolled {
    background-color: color-mix(in srgb, var(--color-dark-deep) 82%, transparent);
    border-bottom: 1px solid var(--divider);
    backdrop-filter: blur(18px);
  }

  /* Hamburger: three bars that morph into an X while the drawer is open. */
  .hamburger {
    position: relative;
    z-index: 50;
    display: flex;
    height: 40px;
    width: 40px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    border-radius: 9999px;
  }
  .hamburger-bar {
    display: block;
    height: 2px;
    width: 20px;
    background-color: var(--fg);
    border-radius: 2px;
    transition: transform 0.3s var(--ease-snap), opacity 0.2s var(--ease-snap);
  }
  .hamburger.is-open .hamburger-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .hamburger.is-open .hamburger-bar:nth-child(2) {
    opacity: 0;
  }
  .hamburger.is-open .hamburger-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile drawer: full-viewport panel, fades + slides down from under the header. */
  .mobile-menu {
    position: fixed;
    z-index: 40;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 7rem 1.5rem 2.5rem;
    background-color: color-mix(in srgb, var(--color-navy-dark) 97%, transparent);
    backdrop-filter: blur(20px);
    opacity: 0;
    transform: translateY(-16px);
    pointer-events: none;
    transition: opacity 0.3s var(--ease-snap), transform 0.35s var(--ease-snap);
  }
  .mobile-menu.is-open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .mobile-menu-links {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .mobile-menu-footer {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  :global(body.menu-open) {
    overflow: hidden;
  }
</style>

<script>
  // Re-bound on `astro:page-load` (fires on initial load and after every
  // view transition swap) since the header itself is replaced per
  // navigation, not persisted, so its `active` prop stays correct.
  document.addEventListener("astro:page-load", () => {
    const nav = document.getElementById("site-nav");
    if (!nav) return;

    // Guards against double-binding if this callback ever fires more than
    // once for the same header instance (astro:page-load can compound
    // listeners across swaps): without it, repeated navigations would
    // stack duplicate click handlers on the same live toggle button.
    if (nav.dataset.navBound === "true") return;
    nav.dataset.navBound = "true";

    function updateNav() {
      nav.classList.toggle("nav-scrolled", window.scrollY > 20);
    }
    window.addEventListener("scroll", updateNav, { passive: true });
    updateNav();

    const menuToggle = document.getElementById("mobile-menu-toggle");
    const menu = document.getElementById("mobile-menu");
    if (!menuToggle || !menu) return;

    function onKeydown(event: KeyboardEvent) {
      if (event.key === "Escape") {
        closeMenu();
        menuToggle?.focus();
      }
    }

    function openMenu() {
      menu?.classList.add("is-open");
      menuToggle?.classList.add("is-open");
      menuToggle?.setAttribute("aria-expanded", "true");
      menu?.setAttribute("aria-hidden", "false");
      menu?.removeAttribute("inert");
      document.body.classList.add("menu-open");
      document.addEventListener("keydown", onKeydown);
      menu?.querySelector("a")?.focus();
    }

    function closeMenu() {
      menu?.classList.remove("is-open");
      menuToggle?.classList.remove("is-open");
      menuToggle?.setAttribute("aria-expanded", "false");
      menu?.setAttribute("aria-hidden", "true");
      menu?.setAttribute("inert", "");
      document.body.classList.remove("menu-open");
      document.removeEventListener("keydown", onKeydown);
    }

    menuToggle.addEventListener("click", () => {
      menu.classList.contains("is-open") ? closeMenu() : openMenu();
    });

    menu.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
  });
</script>
