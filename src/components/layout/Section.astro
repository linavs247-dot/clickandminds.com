---
// A section wrapper. "tone" chooses how strongly this section's
// background stands out against the shared page-level gradient wash
// (see global.css's body rule):
//   - "base": fully transparent, blends straight into the page wash.
//   - "emphasis": a soft purple gradient band layered on top, with
//     feathered top/bottom edges so it fades into neighboring sections
//     rather than cutting at a hard line.
interface Props {
  tone?: "base" | "emphasis";
  class?: string;
  id?: string;
}

const { tone = "base", class: className = "", id } = Astro.props;

const baseClasses =
  tone === "emphasis"
    ? "bg-gradient-to-b from-transparent via-[var(--emphasis-gradient-from)] to-transparent text-[var(--fg)]"
    : "text-[var(--fg)]";
---

<section
  id={id}
  class={`relative overflow-hidden py-24 sm:py-32 ${baseClasses} ${className}`}
>
  <div class="relative z-10 mx-auto max-w-6xl px-6">
    <slot />
  </div>
</section>
