---
import Section from "../layout/Section.astro";
import Headline from "../ui/Headline.astro";
import Highlight from "../ui/Highlight.astro";
import Button from "../ui/Button.astro";
import GlowOrb from "../animations/GlowOrb.astro";
import { GOOGLE_FORM_URL } from "../../lib/constants";
import type { HomeCopy } from "../../i18n/content/types";

interface Props {
  copy: HomeCopy["finalCta"];
}

const { copy } = Astro.props;
---

<Section tone="emphasis" class="text-center">
  <GlowOrb color="purple" size={480} class="left-10 top-0" />
  <GlowOrb color="purple" size={320} class="bottom-0 right-10" />

  <div class="relative mx-auto max-w-2xl">
    <Headline as="h2" lead={copy.headlineLead} class="mx-auto text-4xl font-display font-extrabold leading-[1.15] tracking-tight sm:text-5xl">
      <Highlight>{copy.highlight}</Highlight>
    </Headline>
    <p class="mx-auto mt-6 max-w-md text-lg text-[var(--fg)]/75">
      {copy.body}
    </p>
    <Button href={GOOGLE_FORM_URL} external variant="lime" size="lg" class="mt-9">
      {copy.cta}
    </Button>
  </div>
</Section>
