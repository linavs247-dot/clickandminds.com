---
import Section from "../layout/Section.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import Headline from "../ui/Headline.astro";
import Highlight from "../ui/Highlight.astro";
import Button from "../ui/Button.astro";
import GlowOrb from "../animations/GlowOrb.astro";
import VideoFrame from "../layout/VideoFrame.astro";
import { GOOGLE_FORM_URL } from "../../lib/constants";
import type { HomeCopy } from "../../i18n/content/types";

interface Props {
  copy: HomeCopy["hero"];
}

const { copy } = Astro.props;
---

<Section id="home-hero" tone="emphasis" class="pt-32 sm:pt-40">
  <GlowOrb color="purple" size={560} class="-top-40 -left-32" parallax={18} />
  <GlowOrb color="pink" size={420} class="top-20 right-0" parallax={28} />
  <div class="cursor-glow pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-500" aria-hidden="true"></div>

  <div class="grid items-center gap-14 lg:grid-cols-2">
    <div>
      <Eyebrow>{copy.eyebrow}</Eyebrow>
      <Headline as="h1" lead={copy.headlineLead} class="mt-5 text-5xl font-display font-extrabold leading-[1.15] tracking-tight sm:text-6xl lg:text-7xl">
        <Highlight>{copy.highlight}</Highlight>
      </Headline>
      <p class="mt-6 max-w-lg text-lg leading-relaxed text-[var(--fg-muted)]">
        {copy.body}
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <Button href={GOOGLE_FORM_URL} external variant="lime" size="lg">
          {copy.ctaPrimary}
        </Button>
        <Button href="#demos" variant="ghost" size="lg">
          {copy.ctaSecondary}
        </Button>
      </div>
      <p class="mt-8 flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.15em] text-[var(--fg)]/40">
        <span class="h-px w-8 bg-current"></span>
        {copy.socialProof}
      </p>
    </div>

    <div class="relative lg:w-[122%]">
      <VideoFrame src="/videos/video-1-demo.mp4" variant="immersive" class="w-full" />
    </div>
  </div>
</Section>

<style>
  .cursor-glow {
    background: radial-gradient(
      circle 260px at var(--cx, 50%) var(--cy, 50%),
      rgba(143, 92, 255, 0.18),
      transparent 70%
    );
  }
</style>

<script>
  // Subtle mouse parallax on the hero's floating gradient orbs (each
  // GlowOrb opts in via a `data-parallax` strength in px), plus a soft
  // radial glow that follows the cursor directly (hero only, per the
  // polish pass, not site-wide). Runs on `astro:page-load` for view-
  // transition safety; disabled entirely under prefers-reduced-motion
  // rather than just skipping the CSS transition, since this is a
  // JS-driven transform, not a CSS animation.
  document.addEventListener("astro:page-load", () => {
    const hero = document.getElementById("home-hero");
    if (!hero) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const orbs = Array.from(
      hero.querySelectorAll<HTMLElement>("[data-parallax]")
    );
    const cursorGlow = hero.querySelector<HTMLElement>(".cursor-glow");

    let rafId = 0;
    function handleMove(event: MouseEvent) {
      const rect = hero!.getBoundingClientRect();
      const nx = (event.clientX - rect.left) / rect.width - 0.5;
      const ny = (event.clientY - rect.top) / rect.height - 0.5;
      cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(() => {
        for (const orb of orbs) {
          const strength = Number(orb.dataset.parallax) || 0;
          orb.style.setProperty("--px", `${nx * strength}px`);
          orb.style.setProperty("--py", `${ny * strength}px`);
        }
        if (cursorGlow) {
          cursorGlow.style.setProperty("--cx", `${event.clientX - rect.left}px`);
          cursorGlow.style.setProperty("--cy", `${event.clientY - rect.top}px`);
        }
      });
    }
    function handleEnter() {
      cursorGlow?.classList.remove("opacity-0");
    }
    function handleLeave() {
      cancelAnimationFrame(rafId);
      for (const orb of orbs) {
        orb.style.removeProperty("--px");
        orb.style.removeProperty("--py");
      }
      cursorGlow?.classList.add("opacity-0");
    }

    hero.addEventListener("mousemove", handleMove);
    hero.addEventListener("mouseenter", handleEnter);
    hero.addEventListener("mouseleave", handleLeave);
  });
</script>
