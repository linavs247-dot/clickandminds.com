---
import Section from "../layout/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Highlight from "../ui/Highlight.astro";
import StepIcon from "../ui/StepIcon.astro";

const steps = [
  { title: "We map your workflow.", body: "We learn how your business actually runs before we design anything.", icon: "map" as const },
  { title: "We design your AI employee.", body: "We scope exactly what it should do, and how it fits your business.", icon: "gear" as const },
  { title: "We customize it to you.", body: "Your brand, your tone, your tools. Nothing generic, nothing off the shelf.", icon: "sliders" as const },
  { title: "It starts working for you.", body: "Your AI employee goes live and keeps working, day and night.", icon: "bolt" as const },
];
---

<Section tone="paper">
  <SectionHeading eyebrow="How it works" align="center" class="mx-auto" headingLead="From workflow to">
    <Highlight pin="bottom-left">working AI employee.</Highlight>
  </SectionHeading>

  <div class="how-it-works-track relative mt-16">
    <div class="absolute left-0 right-0 top-6 hidden h-0.5 bg-[var(--fg)]/10 md:block">
      <div class="how-it-works-fill h-full w-0 bg-lime transition-[width] duration-[1400ms] ease-out"></div>
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-4 md:gap-6">
      {steps.map((step, i) => (
        <div class="relative">
          <div class="relative z-10 flex h-12 w-12 items-center justify-center rounded-full border-2 border-[var(--fg)] bg-[var(--card-bg)] font-mono text-sm font-bold text-[var(--fg)]">
            {i + 1}
          </div>
          <h3 class="mt-5 font-display text-lg font-bold text-[var(--fg)]">{step.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--fg)]/70">{step.body}</p>
          <StepIcon variant={step.icon} class="mt-4 text-[var(--fg)]/60" />
        </div>
      ))}
    </div>
  </div>
</Section>

<script>
  // Re-runs on `astro:page-load` so this fires again if the visitor lands
  // here via a client-side view transition, not just a hard page load.
  document.addEventListener("astro:page-load", () => {
    const track = document.querySelector(".how-it-works-track");
    const fill = document.querySelector<HTMLElement>(".how-it-works-fill");
    if (!track || !fill) return;

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (prefersReducedMotion) {
      fill.style.width = "100%";
    } else {
      fill.style.width = "0%";
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            fill.style.width = "100%";
            observer.disconnect();
          }
        },
        { threshold: 0.4 }
      );
      observer.observe(track);
    }
  });
</script>
