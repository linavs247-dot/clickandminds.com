---
import Section from "../layout/Section.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import Button from "../ui/Button.astro";
import GlowOrb from "../animations/GlowOrb.astro";
import { GOOGLE_FORM_URL } from "../../lib/constants";
import type { HomeCopy } from "../../i18n/content/types";

interface Props {
  copy: HomeCopy["limitedSpots"];
}

const { copy } = Astro.props;
---

<Section tone="emphasis" class="text-center">
  <GlowOrb color="pink" size={520} class="left-1/2 top-0 -translate-x-1/2" />

  <div class="relative mx-auto max-w-xl">
    <Eyebrow class="justify-center text-lime">{copy.eyebrow}</Eyebrow>
    <p class="mt-6 text-lg leading-relaxed text-[var(--fg)]/85">
      {copy.body}
    </p>
    <Button href={GOOGLE_FORM_URL} external variant="lime" size="lg" class="mt-8">
      {copy.cta}
    </Button>
  </div>
</Section>
