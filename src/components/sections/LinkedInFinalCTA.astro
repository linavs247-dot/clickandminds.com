---
import Section from "../layout/Section.astro";
import Headline from "../ui/Headline.astro";
import Highlight from "../ui/Highlight.astro";
import Button from "../ui/Button.astro";
import GlowOrb from "../animations/GlowOrb.astro";
import { GOOGLE_FORM_URL } from "../../lib/constants";
---

<Section tone="contrast" class="text-center">
  <GlowOrb color="purple" size={480} class="left-10 top-0" />
  <GlowOrb color="blue" size={380} class="bottom-0 right-10" />

  <div class="relative mx-auto max-w-2xl">
    <Headline as="h2" lead="Ready to automate it later?" class="text-3xl font-display font-extrabold leading-[1.15] tracking-tight sm:text-4xl">
      <Highlight pin="top-right">That's what our AI Systems are for.</Highlight>
    </Headline>
    <p class="mx-auto mt-6 max-w-md text-lg text-[var(--fg)]/75">
      Once your content engine is running, we can build the automation layer on top of
      it. Same operator, one system that keeps growing with you.
    </p>
    <div class="mt-9 flex flex-wrap items-center justify-center gap-4">
      <Button href={GOOGLE_FORM_URL} external variant="lime" size="lg">
        Book a Free Strategy Call
      </Button>
      <Button href="/" variant="ghost" size="lg">
        Explore AI Agents
      </Button>
    </div>
  </div>
</Section>
