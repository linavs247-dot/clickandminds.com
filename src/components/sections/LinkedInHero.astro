---
import Section from "../layout/Section.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import Headline from "../ui/Headline.astro";
import Highlight from "../ui/Highlight.astro";
import Button from "../ui/Button.astro";
import LinkedInMark from "../animations/LinkedInMark.astro";
import { GOOGLE_FORM_URL } from "../../lib/constants";
---

<Section id="linkedin-hero" tone="paper" class="pt-32 text-center sm:pt-40">
  <LinkedInMark size={48} class="left-[6%] top-24 text-[var(--fg)] sm:left-[10%]" parallax={16} />
  <LinkedInMark size={64} class="right-[8%] top-40 text-[var(--fg)] [animation-delay:1.5s] sm:right-[12%]" parallax={24} />
  <LinkedInMark size={38} class="bottom-16 left-[16%] text-[var(--fg)] [animation-delay:3s]" parallax={12} />
  <LinkedInMark size={44} variant="filled" class="bottom-10 right-[18%] text-lime [animation-delay:2s]" parallax={20} />

  <Eyebrow class="justify-center">Done for you LinkedIn content</Eyebrow>
  <Headline as="h1" lead="Content that sounds like you," class="mx-auto mt-5 max-w-3xl text-5xl font-display font-extrabold leading-[1.15] tracking-tight sm:text-6xl">
    <Highlight pin="top-right">built for you.</Highlight>
  </Headline>
  <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-[var(--fg)]/70">
    Strategy, ideation, research, scripting, design, and publishing. You show up, grow
    your authority, and close clients.
  </p>
  <div class="mt-9 flex flex-wrap items-center justify-center gap-4">
    <Button href={GOOGLE_FORM_URL} external variant="lime" size="lg">
      Book a Free Strategy Call
    </Button>
    <Button href="#plans" variant="ghost" size="lg">
      See the Plans
    </Button>
  </div>
</Section>

<script>
  // Same subtle mouse-parallax treatment as HomeHero.astro, applied here
  // to the floating LinkedInMark icons instead of GlowOrbs. See that
  // file's script for the full rationale (custom-property approach,
  // reduced-motion handling, astro:page-load re-binding).
  document.addEventListener("astro:page-load", () => {
    const hero = document.getElementById("linkedin-hero");
    if (!hero) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const marks = Array.from(
      hero.querySelectorAll<HTMLElement>("[data-parallax]")
    );
    if (marks.length === 0) return;

    let rafId = 0;
    function handleMove(event: MouseEvent) {
      const rect = hero!.getBoundingClientRect();
      const nx = (event.clientX - rect.left) / rect.width - 0.5;
      const ny = (event.clientY - rect.top) / rect.height - 0.5;
      cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(() => {
        for (const mark of marks) {
          const strength = Number(mark.dataset.parallax) || 0;
          mark.style.setProperty("--px", `${nx * strength}px`);
          mark.style.setProperty("--py", `${ny * strength}px`);
        }
      });
    }
    function handleLeave() {
      cancelAnimationFrame(rafId);
      for (const mark of marks) {
        mark.style.removeProperty("--px");
        mark.style.removeProperty("--py");
      }
    }

    hero.addEventListener("mousemove", handleMove);
    hero.addEventListener("mouseleave", handleLeave);
  });
</script>
