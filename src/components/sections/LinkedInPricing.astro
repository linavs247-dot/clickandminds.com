---
import Section from "../layout/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Highlight from "../ui/Highlight.astro";
import Badge from "../ui/Badge.astro";
import Button from "../ui/Button.astro";
import GlowOrb from "../animations/GlowOrb.astro";
import FadeIn from "../animations/FadeIn.tsx";
import { GOOGLE_FORM_URL } from "../../lib/constants";

const plans = [
  {
    name: "Starter",
    price: "$1,500",
    featured: false,
    features: [
      "12 posts written and scheduled every month",
      "2 carousels designed every month",
      "2 infographics designed every month",
      "Content calendar and monthly strategy call",
      "Profile optimization guide included",
      "You approve every post before it goes live",
      "Scripting and design included",
      "Weekday email support",
      "Monthly analytics report",
    ],
  },
  {
    name: "Growth",
    price: "$2,500",
    featured: true,
    subtitle: "",
    features: [
      "Everything in Starter",
      "20 posts every month",
      "4 carousels designed every month",
      "4 infographics designed every month",
      "Revision rounds included",
      "Scripting and design included",
      "Uploading and publishing included",
      "Weekday email support",
      "Monthly analytics report",
    ],
  },
  {
    name: "Authority",
    price: "$3,500",
    featured: false,
    subtitle: "The complete content engine",
    features: [
      "Everything in Growth",
      "30 posts every month",
      "8 carousels and 6 infographics every month",
      "Video editing included, the only tier with video",
      "Uploading and publishing included",
      "One lead magnet included as a thank you",
      "Weekday email support",
      "Monthly analytics report",
    ],
  },
];
---

<Section tone="night" id="plans">
  <GlowOrb color="purple" size={460} class="-top-24 left-1/4" />

  <SectionHeading eyebrow="Plans" align="center" class="mx-auto" headingLead="Choose your">
    <Highlight pin="top-right">content plan.</Highlight>
  </SectionHeading>

  <div class="mt-16 grid grid-cols-1 gap-6 lg:grid-cols-3 lg:items-end">
    {plans.map((plan, i) => (
      <FadeIn client:visible delay={i * 100}>
        <div
          data-theme={plan.featured ? "light" : undefined}
          class={`relative flex flex-col rounded-3xl p-8 transition-all duration-300 ${
            plan.featured
              ? "border-2 border-lime bg-white-soft text-[var(--fg)] lg:scale-105 lg:hover:scale-[1.07] hover:shadow-[0_0_40px_-12px_rgba(239,255,115,0.5)]"
              : "border border-[var(--card-border)] bg-[var(--card-bg)] text-[var(--fg)] backdrop-blur-sm hover:-translate-y-1 hover:border-neon-purple/50 hover:shadow-[0_0_35px_-12px_rgba(143,92,255,0.55)]"
          }`}
        >
          {plan.featured && (
            <Badge variant="pill" class="absolute -top-8 left-1/2 -translate-x-1/2 whitespace-nowrap">
              Most Popular
            </Badge>
          )}

          <p class="font-mono text-xs font-semibold uppercase tracking-[0.1em] text-[var(--eyebrow-fg)]">
            {plan.name}
          </p>
          <p class="mt-3 font-display text-4xl font-extrabold leading-none">
            {plan.price}
            <span class="text-base font-medium opacity-60">/mo</span>
          </p>
          {plan.subtitle && (
            <p class="mt-1.5 text-xs font-medium text-[var(--eyebrow-fg)]">{plan.subtitle}</p>
          )}

          <ul class="mt-6 flex-1 space-y-2 border-t border-[var(--divider)] pt-6">
            {plan.features.map((feature) => (
              <li class="flex items-start gap-2.5 text-[12.5px] leading-snug opacity-90">
                <span class="mt-0.5 shrink-0 text-[var(--eyebrow-fg)]">✓</span>
                {feature}
              </li>
            ))}
          </ul>

          <Button
            href={GOOGLE_FORM_URL}
            external
            variant={plan.featured ? "solid" : "ghost"}
            size="md"
            class="mt-8 w-full justify-center"
          >
            Start with {plan.name}
          </Button>
        </div>
      </FadeIn>
    ))}
  </div>

  <p class="mx-auto mt-10 max-w-xl text-center text-sm leading-relaxed text-[var(--fg-muted)]">
    Hiring a designer, a video editor, and a ghostwriter separately costs $6,000 or more
    a month. Consistency is what actually compounds on LinkedIn.
  </p>
</Section>
