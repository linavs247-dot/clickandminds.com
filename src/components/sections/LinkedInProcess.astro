---
import Section from "../layout/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Highlight from "../ui/Highlight.astro";
import StepIcon from "../ui/StepIcon.astro";

const steps = [
  { title: "We map your voice.", body: "A strategy call to learn your audience, your goals, and how you actually talk.", icon: "map" as const },
  { title: "We plan the calendar.", body: "Topics, formats, and cadence planned out before we write a single word.", icon: "calendar" as const },
  { title: "You approve, we create.", body: "Scripts, carousels, infographics, and video edits, ready for your review.", icon: "check" as const },
  { title: "We publish and report.", body: "Posts go live on schedule, and you get a monthly report on what worked.", icon: "send" as const },
];
---

<Section tone="paper">
  <SectionHeading eyebrow="How it works" align="center" class="mx-auto" headingLead="From strategy call to">
    <Highlight pin="top-right">published post.</Highlight>
  </SectionHeading>

  <div class="linkedin-process-track relative mt-16">
    <div class="absolute left-0 right-0 top-6 hidden h-0.5 bg-[var(--fg)]/10 md:block">
      <div class="linkedin-process-fill h-full w-0 bg-lime transition-[width] duration-[1400ms] ease-out"></div>
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-4 md:gap-6">
      {steps.map((step, i) => (
        <div class="relative">
          <div class="relative z-10 flex h-12 w-12 items-center justify-center rounded-full border-2 border-[var(--fg)] bg-[var(--card-bg)] font-mono text-sm font-bold text-[var(--fg)]">
            {i + 1}
          </div>
          <h3 class="mt-5 font-display text-lg font-bold text-[var(--fg)]">{step.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--fg)]/70">{step.body}</p>
          <StepIcon variant={step.icon} class="mt-4 text-[var(--fg)]/60" />
        </div>
      ))}
    </div>
  </div>
</Section>

<script>
  // Re-runs on `astro:page-load` so this fires again if the visitor lands
  // here via a client-side view transition, not just a hard page load.
  document.addEventListener("astro:page-load", () => {
    const track = document.querySelector(".linkedin-process-track");
    const fill = document.querySelector<HTMLElement>(".linkedin-process-fill");
    if (!track || !fill) return;

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (prefersReducedMotion) {
      fill.style.width = "100%";
    } else {
      fill.style.width = "0%";
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            fill.style.width = "100%";
            observer.disconnect();
          }
        },
        { threshold: 0.4 }
      );
      observer.observe(track);
    }
  });
</script>
