---
import Section from "../layout/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Highlight from "../ui/Highlight.astro";
import Button from "../ui/Button.astro";
import GlowOrb from "../animations/GlowOrb.astro";
import FadeIn from "../animations/FadeIn.tsx";
import { GOOGLE_FORM_URL } from "../../lib/constants";
import type { HomeCopy } from "../../i18n/content/types";

interface Props {
  copy: HomeCopy["pricing"];
}

const { copy } = Astro.props;
---

<Section tone="emphasis">
  <GlowOrb color="purple" size={460} class="-top-24 left-1/4" />

  <SectionHeading eyebrow={copy.eyebrow} align="center" class="mx-auto" headingLead={copy.headlineLead}>
    <Highlight pin="bottom-left">{copy.highlight}</Highlight>
  </SectionHeading>

  <div class="mt-14 grid grid-cols-1 gap-6 lg:grid-cols-3">
    {copy.plans.map((plan, i) => (
      <FadeIn client:visible delay={i * 100} className="h-full">
        <div class="flex h-full flex-col rounded-3xl border border-[var(--card-border)] bg-[var(--card-bg)] p-8 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-neon-purple/50 hover:shadow-[0_0_35px_-12px_rgba(143,92,255,0.55)]">
          <p class="font-mono text-xs font-semibold uppercase tracking-[0.1em] text-[var(--eyebrow-fg)]">{plan.name}</p>
          <p class="mt-3 font-display text-3xl font-extrabold leading-none text-[var(--fg)]">{plan.price}</p>
          <p class="mt-1 text-xs text-[var(--fg)]/50">{plan.unit}</p>
          <p class="mt-4 border-t border-[var(--divider)] pt-4 text-sm text-[var(--fg-muted)]">{plan.description}</p>

          <ul class="mt-6 flex-1 space-y-3">
            {plan.features.map((feature) => (
              <li class="flex items-start gap-2.5 text-[13.5px] text-[var(--fg)]/80">
                <span class="mt-0.5 text-[var(--eyebrow-fg)]">✓</span>
                {feature}
              </li>
            ))}
          </ul>

          <Button href={GOOGLE_FORM_URL} external variant="ghost" size="md" class="mt-8 w-full justify-center">
            {plan.cta}
          </Button>
        </div>
      </FadeIn>
    ))}
  </div>
</Section>
