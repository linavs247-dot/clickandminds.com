---
import Section from "../layout/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Highlight from "../ui/Highlight.astro";
import Headline from "../ui/Headline.astro";
import GlowOrb from "../animations/GlowOrb.astro";
import AgentShowcaseCarousel from "../demos/AgentShowcaseCarousel.tsx";
import FadeIn from "../animations/FadeIn.tsx";
import type { HomeCopy } from "../../i18n/content/types";

interface Props {
  copy: HomeCopy["demos"];
}

const { copy } = Astro.props;
---

<Section tone="base">
  <SectionHeading eyebrow={copy.eyebrow} headingLead={copy.headlineLead}>
    <Highlight pin="bottom-left">{copy.highlight}</Highlight>
    <p slot="lead">
      {copy.leadText}
    </p>
  </SectionHeading>

  <div class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {copy.items.map((demo, i) => (
      <FadeIn client:visible delay={i * 80} className="h-full">
        <div class="h-full rounded-2xl border border-[var(--card-border)] bg-[var(--card-bg)] p-6 shadow-sm transition-transform duration-300 hover:-translate-y-1">
          <div class="h-1.5 w-10 rounded-full bg-lime"></div>
          <p class="mt-4 font-mono text-[10px] uppercase tracking-[0.15em] text-[var(--fg)]/50">
            {demo.tag}
          </p>
          <h3 class="mt-2 font-display text-lg font-bold text-[var(--fg)]">{demo.name}</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--fg-muted)]">{demo.description}</p>
        </div>
      </FadeIn>
    ))}
  </div>

  <div class="relative mt-16 overflow-hidden rounded-3xl bg-gradient-to-br from-[var(--emphasis-gradient-from)] to-transparent p-10 sm:p-14">
    <GlowOrb color="purple" size={420} class="-top-20 -right-20" />
    <div class="relative z-10 text-center">
      <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--eyebrow-fg)]">{copy.carouselEyebrow}</p>
      <Headline as="h3" lead={copy.carouselHeadlineLead} class="mx-auto mt-4 max-w-lg text-3xl font-display font-extrabold leading-[1.15] sm:text-4xl">
        <Highlight pin="top-right">{copy.carouselHighlight}</Highlight>
      </Headline>
      <AgentShowcaseCarousel client:visible />
    </div>
  </div>
</Section>
