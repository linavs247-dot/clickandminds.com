---
import Section from "../layout/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Highlight from "../ui/Highlight.astro";
import GlowOrb from "../animations/GlowOrb.astro";
import FadeIn from "../animations/FadeIn.tsx";
import type { WebsitesPageCopy } from "../../i18n/content/types";

interface Props {
  copy: WebsitesPageCopy["services"];
}

const { copy } = Astro.props;
---

<Section tone="emphasis">
  <GlowOrb color="purple" size={460} class="-top-24 right-1/4" />

  <SectionHeading eyebrow={copy.eyebrow} align="center" class="mx-auto" headingLead={copy.headlineLead}>
    <Highlight pin="top-right">{copy.highlight}</Highlight>
  </SectionHeading>

  <div class="mt-14 grid grid-cols-1 gap-6 lg:grid-cols-3">
    {copy.items.map((service, i) => (
      <FadeIn client:visible delay={i * 100} className="h-full">
        <div class="flex h-full flex-col rounded-3xl border border-[var(--card-border)] bg-[var(--card-bg)] p-8 shadow-[var(--card-shadow)] backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-neon-purple/40">
          <p class="font-display text-xl font-bold text-[var(--fg)]">{service.name}</p>
          <p class="mt-3 border-t border-[var(--divider)] pt-4 text-base leading-relaxed text-[var(--fg-muted)]">
            {service.outcome}
          </p>

          <ul class="mt-6 flex-1 space-y-3">
            {service.includes.map((item) => (
              <li class="flex items-start gap-2.5 text-[13.5px] text-[var(--fg)]/80">
                <span class="mt-0.5 text-[var(--eyebrow-fg)]">✓</span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </FadeIn>
    ))}
  </div>
</Section>
