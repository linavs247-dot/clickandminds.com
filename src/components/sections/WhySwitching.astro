---
import Section from "../layout/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Highlight from "../ui/Highlight.astro";
import Counter from "../ui/Counter.tsx";
import FadeIn from "../animations/FadeIn.tsx";
import type { HomeCopy } from "../../i18n/content/types";

interface Props {
  copy: HomeCopy["whySwitching"];
}

const { copy } = Astro.props;
---

<Section tone="base">
  <div class="grid gap-14 lg:grid-cols-2">
    <div>
      <SectionHeading eyebrow={copy.eyebrow} headingLead={copy.headlineLead}>
        <Highlight>{copy.highlight}</Highlight>
      </SectionHeading>

      <ul class="mt-8 space-y-4">
        {copy.checklist.map((item) => (
          <li class="flex items-start gap-3 text-base text-[var(--fg)]/85">
            <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-lime text-xs font-bold text-[var(--fg)]">
              ✓
            </span>
            {item}
          </li>
        ))}
      </ul>
    </div>

    <div class="grid grid-cols-2 gap-5">
      <FadeIn client:visible delay={0}>
        <div class="rounded-2xl border border-[var(--fg)]/10 bg-[var(--card-bg)] p-6 text-center shadow-[var(--card-shadow)]">
          <p class="font-display text-4xl font-extrabold text-[var(--fg)]">
            <Counter client:visible from={0} to={40} suffix="h" />
          </p>
          <p class="mt-2 font-mono text-[10px] uppercase tracking-[0.15em] text-[var(--fg)]/50">
            {copy.stats.savedMonthlyLabel}
          </p>
        </div>
      </FadeIn>
      <FadeIn client:visible delay={100}>
        <div class="rounded-2xl border border-[var(--fg)]/10 bg-[var(--card-bg)] p-6 text-center shadow-[var(--card-shadow)]">
          <p class="font-display text-4xl font-extrabold text-[var(--fg)]">
            <Counter client:visible from={0} to={100} suffix="%" />
          </p>
          <p class="mt-2 font-mono text-[10px] uppercase tracking-[0.15em] text-[var(--fg)]/50">
            {copy.stats.systemOwnershipLabel}
          </p>
        </div>
      </FadeIn>
      <FadeIn client:visible delay={200}>
        <div class="rounded-2xl border border-[var(--fg)]/10 bg-[var(--card-bg)] p-6 text-center shadow-[var(--card-shadow)]">
          <p class="font-display text-2xl font-extrabold text-[var(--fg)]">{copy.stats.taskTimeValue}</p>
          <p class="mt-2 font-mono text-[10px] uppercase tracking-[0.15em] text-[var(--fg)]/50">
            {copy.stats.taskTimeLabel}
          </p>
        </div>
      </FadeIn>
      <FadeIn client:visible delay={300}>
        <div class="rounded-2xl border border-[var(--fg)]/10 bg-[var(--card-bg)] p-6 text-center shadow-[var(--card-shadow)]">
          <p class="font-display text-2xl font-extrabold text-[var(--fg)]">{copy.stats.directBuildValue}</p>
          <p class="mt-2 font-mono text-[10px] uppercase tracking-[0.15em] text-[var(--fg)]/50">
            {copy.stats.directBuildLabel}
          </p>
        </div>
      </FadeIn>
    </div>
  </div>
</Section>
