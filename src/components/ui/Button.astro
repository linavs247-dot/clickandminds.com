---
interface Props {
  href?: string;
  variant?: "lime" | "solid" | "ghost";
  size?: "md" | "lg";
  external?: boolean;
  class?: string;
}

const {
  href,
  variant = "lime",
  size = "md",
  external = false,
  class: className = "",
} = Astro.props;

const base =
  "group relative inline-flex items-center justify-center gap-2 rounded-full font-display font-semibold " +
  "transition-all duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] " +
  "hover:-translate-y-0.5 active:translate-y-0 active:duration-75 overflow-hidden";

const sizes = {
  md: "px-6 py-3 text-sm",
  lg: "px-8 py-4 text-base",
};

const variants = {
  lime:
    "bg-lime/30 text-purple-primary backdrop-blur-md border border-lime/60 " +
    "shadow-[inset_0_1px_0_rgba(255,255,255,0.4),0_0_25px_-2px_rgba(239,255,115,0.5)] " +
    "hover:bg-lime/40 hover:brightness-110 hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.5),0_0_35px_-2px_rgba(239,255,115,0.75)]",
  solid:
    "bg-neon-purple text-white-soft shadow-[0_0_25px_-2px_rgba(143,92,255,0.6)] " +
    "hover:shadow-[0_0_35px_-2px_rgba(143,92,255,0.8)]",
  ghost:
    "bg-navy-dark/30 text-[var(--fg)] backdrop-blur-md border border-[var(--fg)]/20 " +
    "hover:border-[var(--ghost-hover)]/60 hover:bg-navy-dark/50",
};

const classes = [base, sizes[size], variants[variant], className].join(" ");
const externalProps = external ? { target: "_blank", rel: "noopener" } : {};
// Subtle magnetic hover (button nudges toward the cursor within its own
// bounds) is reserved for the primary CTA per the polish pass, not every
// button on the page.
const magnetic = variant === "lime" ? { "data-magnetic": "true" } : {};
---

{
  href ? (
    <a href={href} class={classes} {...externalProps} {...magnetic}>
      <span
        class="pointer-events-none absolute inset-0 -translate-x-full bg-white/25 skew-x-[-20deg] transition-transform duration-500 group-hover:translate-x-full"
        aria-hidden="true"
      />
      <span class="relative z-10 inline-flex items-center gap-2">
        <slot />
      </span>
    </a>
  ) : (
    <button type="button" class={classes} {...magnetic}>
      <span
        class="pointer-events-none absolute inset-0 -translate-x-full bg-white/25 skew-x-[-20deg] transition-transform duration-500 group-hover:translate-x-full"
        aria-hidden="true"
      />
      <span class="relative z-10 inline-flex items-center gap-2">
        <slot />
      </span>
    </button>
  )
}

<script>
  // Subtle magnetic hover: the button nudges a few pixels toward the
  // cursor while hovered, capped well short of the pointer's actual
  // offset so it reads as "aware of you," not "chasing you." A short
  // transform transition covers both the follow and the release, so
  // there is no separate bouncy snap-back state.
  document.addEventListener("astro:page-load", () => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (window.matchMedia("(pointer: coarse)").matches) return;

    document.querySelectorAll<HTMLElement>("[data-magnetic]").forEach((el) => {
      if (el.dataset.magneticBound === "true") return;
      el.dataset.magneticBound = "true";
      el.style.transition = "transform 150ms ease-out";

      const strength = 0.25;
      const maxOffset = 7;
      // Folded in here rather than left to the base classes' CSS
      // `hover:-translate-y-0.5`: once this script sets an inline
      // transform, it wins specificity over that class permanently, so
      // the lift has to be part of the same JS-driven transform or it
      // would silently stop applying the first time the pointer moves.
      const lift = -2;

      el.addEventListener("mouseenter", () => {
        el.style.transform = `translate(0px, ${lift}px)`;
      });

      el.addEventListener("mousemove", (event) => {
        const rect = el.getBoundingClientRect();
        const x = event.clientX - (rect.left + rect.width / 2);
        const y = event.clientY - (rect.top + rect.height / 2);
        const dx = Math.max(-maxOffset, Math.min(maxOffset, x * strength));
        const dy = Math.max(-maxOffset, Math.min(maxOffset, y * strength));
        el.style.transform = `translate(${dx}px, ${dy + lift}px)`;
      });

      el.addEventListener("mouseleave", () => {
        el.style.transform = "translate(0, 0)";
      });
    });
  });
</script>
