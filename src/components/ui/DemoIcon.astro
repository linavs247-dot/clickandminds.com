---
// Line-art icons for the "closer look at what we build" slider, same
// visual language as StepIcon.astro: currentColor strokes with a small
// lime accent for the brand's signature touch.
interface Props {
  variant: "writer" | "dashboard" | "proposal" | "leads" | "reports";
  class?: string;
}

const { variant, class: className = "" } = Astro.props;
---

<svg
  viewBox="0 0 32 32"
  fill="none"
  class={`h-6 w-6 ${className}`}
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {variant === "writer" && (
    <>
      <path d="M8 24 L21 11 L25 7 L27 9 L23 13 L10 26 L6 27 Z" />
      <path d="M18 14 L20 16" />
      <circle cx="25" cy="7.5" r="1.6" fill="var(--color-lime)" stroke="none" />
    </>
  )}
  {variant === "dashboard" && (
    <>
      <rect x="5" y="5" width="10" height="10" rx="2" />
      <rect x="17" y="5" width="10" height="6" rx="2" />
      <rect x="5" y="17" width="6" height="10" rx="2" />
      <rect x="13" y="14" width="14" height="13" rx="2" />
      <circle cx="20" cy="20.5" r="1.6" fill="var(--color-lime)" stroke="none" />
    </>
  )}
  {variant === "proposal" && (
    <>
      <path d="M9 5 H19 L23 9 V27 H9 Z" />
      <path d="M19 5 V9 H23" />
      <path d="M12.5 15 H18.5 M12.5 19 H18.5" />
      <path d="M12 23.2 L14.2 25.4 L19 20" stroke="var(--color-lime)" />
    </>
  )}
  {variant === "leads" && (
    <>
      <path d="M6 7 H26 L18.5 16.5 V25 L13.5 27.5 V16.5 Z" />
      <circle cx="16" cy="10" r="1.6" fill="var(--color-lime)" stroke="none" />
    </>
  )}
  {variant === "reports" && (
    <>
      <path d="M6 27 V6 M6 27 H27" />
      <rect x="10" y="18" width="3.4" height="8" />
      <rect x="16" y="12.5" width="3.4" height="13.5" />
      <rect x="22" y="8" width="3.4" height="18" />
      <circle cx="23.7" cy="8" r="1.6" fill="var(--color-lime)" stroke="none" />
    </>
  )}
</svg>
