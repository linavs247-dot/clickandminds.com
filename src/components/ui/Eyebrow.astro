---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<div
  class={`inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.2em]
  text-[var(--eyebrow-fg)] ${className}`}
>
  <span class="h-px w-5 bg-current" aria-hidden="true"></span>
  <slot />
</div>
