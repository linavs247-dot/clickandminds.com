---
// The accent phrase inside a headline: a purple-gradient text-clip by
// default. Animates in via the shared
// [data-reveal] IntersectionObserver set up once in Layout.astro.
interface Props {
  color?: "gradient" | "lavender";
  class?: string;
}

const { color = "gradient", class: className = "" } = Astro.props;
---

<span
  class={`highlight highlight-${color} ${className}`}
  data-reveal
>
  <span class="highlight-text"><slot /></span>
</span>
