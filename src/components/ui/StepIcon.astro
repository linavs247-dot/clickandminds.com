---
// Small line-art step icons for "How It Works" processes on both pages.
// Strokes use currentColor (so they follow --fg automatically, toggle
// aware like everything else) with a small lime accent dot for the
// brand's signature touch. Simple, consistent, not photographic.
interface Props {
  variant: "map" | "gear" | "calendar" | "sliders" | "check" | "bolt" | "send";
  class?: string;
}

const { variant, class: className = "" } = Astro.props;
---

<svg
  viewBox="0 0 32 32"
  fill="none"
  class={`h-6 w-6 ${className}`}
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {variant === "map" && (
    <>
      <path d="M6 10 L13 7 L20 10 L26 7 V22 L20 25 L13 22 L6 25 Z" />
      <path d="M13 7 V22 M20 10 V25" />
      <circle cx="16.5" cy="15" r="1.6" fill="var(--color-lime)" stroke="none" />
    </>
  )}
  {variant === "gear" && (
    <>
      <circle cx="16" cy="16" r="6" />
      <path d="M16 6 V9 M16 23 V26 M6 16 H9 M23 16 H26 M9.5 9.5 L11.5 11.5 M20.5 20.5 L22.5 22.5 M9.5 22.5 L11.5 20.5 M20.5 11.5 L22.5 9.5" />
      <circle cx="16" cy="16" r="1.8" fill="var(--color-lime)" stroke="none" />
    </>
  )}
  {variant === "calendar" && (
    <>
      <rect x="6" y="8" width="20" height="17" rx="2" />
      <path d="M6 13 H26 M11 6 V10 M21 6 V10" />
      <rect x="10" y="16.5" width="4" height="4" rx="0.8" fill="var(--color-lime)" stroke="none" />
    </>
  )}
  {variant === "sliders" && (
    <>
      <path d="M7 10 H25 M7 16 H25 M7 22 H25" />
      <circle cx="13" cy="10" r="2.1" fill="var(--color-lime)" stroke="currentColor" />
      <circle cx="21" cy="16" r="2.1" fill="var(--color-lime)" stroke="currentColor" />
      <circle cx="11" cy="22" r="2.1" fill="var(--color-lime)" stroke="currentColor" />
    </>
  )}
  {variant === "check" && (
    <>
      <rect x="6" y="6" width="20" height="20" rx="5" />
      <path d="M11.5 16.5 L14.5 19.5 L20.5 12.5" stroke="var(--color-lime)" />
    </>
  )}
  {variant === "bolt" && (
    <path
      d="M17.5 5 L9 18 H15 L14 27 L23.5 13.5 H17 Z"
      fill="var(--color-lime)"
      stroke="currentColor"
      stroke-linejoin="round"
    />
  )}
  {variant === "send" && (
    <>
      <path d="M6 16.5 L25.5 7 L18.5 26 L14.5 18 L6 16.5Z" />
      <path d="M14.5 18 L25.5 7" />
      <circle cx="14.5" cy="18" r="1.5" fill="var(--color-lime)" stroke="none" />
    </>
  )}
</svg>
