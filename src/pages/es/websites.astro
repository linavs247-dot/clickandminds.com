---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import Footer from "../../components/layout/Footer.astro";
import Section from "../../components/layout/Section.astro";
import Badge from "../../components/ui/Badge.astro";
import Headline from "../../components/ui/Headline.astro";
import Highlight from "../../components/ui/Highlight.astro";
import Button from "../../components/ui/Button.astro";
import GlowOrb from "../../components/animations/GlowOrb.astro";
import { GOOGLE_FORM_URL } from "../../lib/constants";
import { defaultLocale, useTranslations, type Locale } from "../../i18n/ui";
import { websitesEs } from "../../i18n/content/websites.es";

const locale = (Astro.currentLocale as Locale | undefined) ?? defaultLocale;
const t = useTranslations(locale);
const copy = websitesEs;
---

<Layout title="Sitios Web" description={copy.body}>
  <Navbar active="websites" />
  <main>
    <Section tone="emphasis" class="flex min-h-screen items-center pt-32 text-center sm:pt-40">
      <GlowOrb color="purple" size={480} class="-top-24 left-1/4" />
      <GlowOrb color="blue" size={360} class="bottom-0 right-1/4" />

      <div class="relative mx-auto max-w-2xl">
        <Badge>{t.comingSoon.badge}</Badge>
        <Headline as="h1" lead={copy.headlineLead} class="mx-auto mt-5 text-4xl font-display font-extrabold leading-[1.15] tracking-tight sm:text-5xl">
          <Highlight pin="top-right">{copy.highlight}</Highlight>
        </Headline>
        <p class="mx-auto mt-6 max-w-md text-lg leading-relaxed text-[var(--fg)]/75">
          {copy.body}
        </p>
        <Button href={GOOGLE_FORM_URL} external variant="lime" size="lg" class="mt-9">
          {copy.cta}
        </Button>
      </div>
    </Section>
  </main>
  <Footer />
</Layout>
