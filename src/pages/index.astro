---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import HomeHero from "../components/sections/HomeHero.astro";
import PainSection from "../components/sections/PainSection.astro";
import ShiftSection from "../components/sections/ShiftSection.astro";
import AIEmployeeGallery from "../components/sections/AIEmployeeGallery.astro";
import ProductDemosPreview from "../components/sections/ProductDemosPreview.astro";
import HowItWorks from "../components/sections/HowItWorks.astro";
import WhySwitching from "../components/sections/WhySwitching.astro";
import Video3Moment from "../components/sections/Video3Moment.astro";
import Pricing from "../components/sections/Pricing.astro";
import LimitedSpots from "../components/sections/LimitedSpots.astro";
