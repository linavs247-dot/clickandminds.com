  <main>
    <HomeHero />
    <PainSection />
    <ShiftSection />
    <AIEmployeeGallery />
    <ProductDemosPreview />
    <HowItWorks />
    <WhySwitching />
    <Video3Moment />
    <Pricing />
    <LimitedSpots />
    <FinalCTA />
