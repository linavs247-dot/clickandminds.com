---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import LinkedInHero from "../components/sections/LinkedInHero.astro";
import WhatsIncludedFree from "../components/sections/WhatsIncludedFree.astro";
import LinkedInPricing from "../components/sections/LinkedInPricing.astro";
import PremiumAddOns from "../components/sections/PremiumAddOns.astro";
import EmailListSection from "../components/sections/EmailListSection.astro";
import LinkedInProcess from "../components/sections/LinkedInProcess.astro";
import LinkedInFAQ from "../components/sections/LinkedInFAQ.astro";
import LinkedInFinalCTA from "../components/sections/LinkedInFinalCTA.astro";
---

<Layout
  title="LinkedIn Studio"
  description="Done for you LinkedIn content. Click & Minds writes, designs, and publishes content that sounds like you, so you show up, grow your authority, and close clients."
>
  <Navbar active="linkedin" />
  <main>
    <LinkedInHero />
    <WhatsIncludedFree />
    <LinkedInPricing />
    <PremiumAddOns />
    <EmailListSection />
    <LinkedInProcess />
    <LinkedInFAQ />
    <LinkedInFinalCTA />
  </main>
  <Footer />
</Layout>
