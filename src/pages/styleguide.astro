---
import Layout from "../layouts/Layout.astro";
import Section from "../components/layout/Section.astro";
import Button from "../components/ui/Button.astro";
import Badge from "../components/ui/Badge.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Highlight from "../components/ui/Highlight.astro";
import Headline from "../components/ui/Headline.astro";
import GlowOrb from "../components/animations/GlowOrb.astro";
import VideoFrame from "../components/layout/VideoFrame.astro";
import FadeIn from "../components/animations/FadeIn.tsx";
import Counter from "../components/ui/Counter.tsx";

const palette = [
  {
    group: "Core / brand ink",
    swatches: [
      { name: "Purple Primary", token: "purple-primary", hex: "#38206F", text: "light" },
      { name: "Purple Deep", token: "purple-deep", hex: "#2A1755", text: "light" },
      { name: "Lavender", token: "lavender", hex: "#B9A8FF", text: "dark" },
      { name: "Lavender Soft", token: "lavender-soft", hex: "#DDD3FF", text: "dark" },
    ],
  },
  {
    group: "Signature accent (both modes)",
    swatches: [{ name: "Lime", token: "lime", hex: "#EFFF73", text: "dark" }],
  },
  {
    group: "Day mode",
    swatches: [
      { name: "White Soft", token: "white-soft", hex: "#FAFAF8", text: "dark" },
      { name: "Paper Dotted", token: "paper-dotted", hex: "#F6F4EF", text: "dark" },
      { name: "Dot", token: "dot", hex: "#D8D2C6", text: "dark" },
    ],
  },
  {
    group: "Night mode",
    swatches: [
      { name: "Navy Dark", token: "navy-dark", hex: "#101426", text: "light" },
      { name: "Dark Gradient", token: "dark-gradient", hex: "#20113F", text: "light" },
      { name: "Neon Purple", token: "neon-purple", hex: "#8F5CFF", text: "light" },
      { name: "Electric Pink", token: "electric-pink", hex: "#E04DFF", text: "light" },
      { name: "Neon Blue", token: "neon-blue", hex: "#47C7FF", text: "dark" },
    ],
  },
];
---

<Layout title="Styleguide" noindex>
  <!-- Minimal top bar just for reviewing the system. -->
  <header
    class="sticky top-0 z-50 flex items-center justify-between border-b border-lime/10 bg-navy-dark/80 px-6 py-4 backdrop-blur-md"
  >
    <div class="font-display text-sm font-extrabold tracking-tight text-white-soft">
      Click & Minds <span class="text-electric-pink">.</span>
      <span class="ml-2 font-mono text-[10px] font-normal uppercase tracking-[0.2em] text-lime/70">
        Styleguide v1
      </span>
    </div>
  </header>

  <!-- INTRO -->
  <Section tone="base">
    <Eyebrow>// design_system.spec</Eyebrow>
    <Headline as="h1" lead="One brand." class="mt-4 max-w-3xl text-5xl font-display font-extrabold leading-[1.15] tracking-tight sm:text-6xl">
      <Highlight pin="top-right">Two modes.</Highlight>
    </Headline>
    <p class="mt-6 max-w-xl text-lg leading-relaxed text-purple-primary/70">
      This page is the source of truth for every color, type style, and component before we
      build a single real page. Flip the toggle top right to preview night mode. The golden
      rule: when the theme changes, the background changes. Typography, purple, lime, and the
      dotted texture stay exactly the same.
    </p>
  </Section>

  <!-- COLOR PALETTE -->
  <Section tone="base">
    <SectionHeading eyebrow="01 / Palette" headingLead="Every color has">
      <Highlight pin="top-right">one job.</Highlight>
    </SectionHeading>

    <div class="mt-12 space-y-10">
      {palette.map((group) => (
        <div>
          <p class="mb-4 font-mono text-[11px] uppercase tracking-[0.15em] text-purple-primary/50">
            {group.group}
          </p>
          <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-5">
            {group.swatches.map((s) => (
              <div class="overflow-hidden rounded-2xl border border-purple-primary/10 bg-white-soft shadow-sm">
                <div
                  class={`flex h-20 items-end p-3 ${s.text === "light" ? "text-white-soft" : "text-purple-primary"}`}
                  style={`background:${s.hex}`}
                >
                  <span class="font-mono text-[10px] uppercase tracking-[0.1em] opacity-80">{s.hex}</span>
                </div>
                <div class="px-3 py-2">
                  <p class="font-display text-[13px] font-bold text-purple-primary">{s.name}</p>
                  <p class="font-mono text-[10px] text-purple-primary/50">--color-{s.token}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </Section>

  <!-- TYPOGRAPHY -->
  <Section tone="emphasis">
    <GlowOrb color="purple" size={480} class="-top-20 -left-20" />
    <GlowOrb color="pink" size={360} class="bottom-0 right-0" />
    <SectionHeading eyebrow="02 / Typography" headingLead="Four typefaces,">
      <Highlight pin="bottom-left">one job each.</Highlight>
    </SectionHeading>

    <div class="mt-12 space-y-10">
      <div>
        <p class="mb-3 font-mono text-[11px] uppercase tracking-[0.15em] text-lime">Sora 800 · Headlines</p>
        <p class="font-display text-5xl font-extrabold leading-[1.15] tracking-tight text-white-soft sm:text-6xl">
          Hire AI <Highlight pin="top-right">employees.</Highlight>
        </p>
      </div>

      <div>
        <p class="mb-3 font-mono text-[11px] uppercase tracking-[0.15em] text-lime">Inter 400/500 · Body</p>
        <p class="max-w-xl text-lg leading-relaxed text-white-soft/80">
          Stop hiring for repetitive work. Start building a business that runs itself. We
          design custom AI agents that research, write, organize, sell, and support your
          business twenty four hours a day.
        </p>
      </div>

      <div>
        <p class="mb-3 font-mono text-[11px] uppercase tracking-[0.15em] text-lime">JetBrains Mono · Eyebrows</p>
        <Eyebrow class="text-lime">AI_AGENTS_AND_AUTOMATION.SPEC</Eyebrow>
      </div>

      <div>
        <p class="mb-3 font-mono text-[11px] uppercase tracking-[0.15em] text-lime">Caveat · Hand highlight</p>
        <p class="font-display text-3xl font-extrabold text-white-soft">
          Built for founders <span class="hl-hand text-4xl text-lime">who hate busywork</span>
        </p>
      </div>
    </div>
  </Section>

  <!-- BUTTONS -->
  <Section tone="base">
    <SectionHeading eyebrow="03 / Buttons" headingLead="Every CTA">
      <Highlight pin="top-right">moves</Highlight> when you touch it.
    </SectionHeading>

    <div class="mt-10 space-y-8">
      <div class="flex flex-wrap items-center gap-4">
        <Button variant="lime" size="lg" href="#">Book a Strategy Call</Button>
        <Button variant="solid" size="lg" href="#">See What We Build</Button>
        <Button variant="ghost" size="lg" href="#">Learn More</Button>
      </div>
      <div class="flex flex-wrap items-center gap-4">
        <Button variant="lime" size="md" href="#">Apply to Work With Us</Button>
        <Button variant="solid" size="md" href="#">View Pricing</Button>
        <Button variant="ghost" size="md" href="#">Contact Us</Button>
      </div>
    </div>
  </Section>

  <Section tone="emphasis">
    <GlowOrb color="blue" size={420} class="top-0 right-10" />
    <p class="mb-6 font-mono text-[11px] uppercase tracking-[0.15em] text-lime">Same buttons, night mode</p>
    <div class="flex flex-wrap items-center gap-4">
      <Button variant="lime" size="lg" href="#">Book a Strategy Call</Button>
      <Button variant="solid" size="lg" href="#">See What We Build</Button>
      <Button variant="ghost" size="lg" href="#">Learn More</Button>
    </div>
  </Section>

  <!-- BADGES -->
  <Section tone="emphasis">
    <GlowOrb color="pink" size={380} class="-top-10 right-0" />
    <SectionHeading eyebrow="04 / Badges & status" headingLead="AI employees are always">
      <Highlight pin="bottom-left">doing something.</Highlight>
    </SectionHeading>

    <div class="mt-10 flex flex-wrap items-center gap-6">
      <Badge variant="pill">Most Popular</Badge>
      <Badge variant="status-active">Active</Badge>
      <Badge variant="status-working">Working…</Badge>
    </div>
  </Section>

  <!-- VIDEO IN DARK SPACE -->
  <Section tone="emphasis">
    <GlowOrb color="purple" size={520} class="-top-32 left-1/4" />
    <GlowOrb color="blue" size={360} class="bottom-0 right-10" />
    <SectionHeading eyebrow="05 / Video meets dark space" headingLead="This is where the">
      <Highlight pin="top-right">videos live.</Highlight>
    </SectionHeading>
    <p class="mt-5 max-w-xl text-base leading-relaxed text-white-soft/70 sm:text-lg">
      Every demo video sits inside dark, glowing space like this, never on cream. This is the
      exact device frame the hero and product demos will use across the real site: glass
      chrome bar, neon border, soft glow behind it.
    </p>
    <VideoFrame
      src="/videos/video-1-demo.mp4"
      class="mx-auto mt-12 max-w-2xl"
    />
  </Section>

  <!-- SECTION HEADINGS -->
  <Section tone="base">
    <SectionHeading eyebrow="06 / Section headings" align="center" class="mx-auto" headingLead="Centered version,">
      <Highlight pin="bottom-left">for closers.</Highlight>
      <p slot="lead">
        This is the lead paragraph slot. It stays short, one or two lines, and sits right
        under the heading before the section content starts.
      </p>
    </SectionHeading>
  </Section>

  <!-- COUNTERS + FADE IN -->
  <Section tone="emphasis">
    <GlowOrb color="lime" size={400} class="top-10 left-1/3" />
    <SectionHeading eyebrow="07 / Animated counters" headingLead="Numbers that">
      <Highlight pin="top-right">land</Highlight> when you scroll.
    </SectionHeading>

    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-3">
      <FadeIn client:visible delay={0}>
        <div class="rounded-2xl border border-neon-purple/30 bg-white/5 p-8 text-center backdrop-blur-sm">
          <p class="font-display text-5xl font-extrabold text-white-soft">
            <Counter client:visible from={0} to={40} suffix="h" />
          </p>
          <p class="mt-2 font-mono text-[11px] uppercase tracking-[0.15em] text-lime">Saved monthly</p>
        </div>
      </FadeIn>
      <FadeIn client:visible delay={120}>
        <div class="rounded-2xl border border-neon-purple/30 bg-white/5 p-8 text-center backdrop-blur-sm">
          <p class="font-display text-5xl font-extrabold text-white-soft">
            <Counter client:visible from={0} to={100} suffix="%" />
          </p>
          <p class="mt-2 font-mono text-[11px] uppercase tracking-[0.15em] text-lime">System ownership</p>
        </div>
      </FadeIn>
      <FadeIn client:visible delay={240}>
        <div class="rounded-2xl border border-neon-purple/30 bg-white/5 p-8 text-center backdrop-blur-sm">
          <p class="font-display text-5xl font-extrabold text-white-soft">
            <Counter client:visible from={4} to={0} prefix="4h → " suffix="min" />
          </p>
          <p class="mt-2 font-mono text-[11px] uppercase tracking-[0.15em] text-lime">Typical task time</p>
        </div>
      </FadeIn>
    </div>
  </Section>

  <!-- APPROVAL NOTE -->
  <Section tone="base">
    <div class="rounded-3xl border-2 border-purple-primary bg-lime px-8 py-10 text-center">
      <p class="font-display text-2xl font-extrabold text-purple-primary">
        Checkpoint: approve this look before Phase 2.
      </p>
      <p class="mx-auto mt-3 max-w-lg text-sm text-purple-primary/80">
        Once the colors, type, buttons, and dark mode feel right, say the word and we build
        the full Home and LinkedIn Studio pages on top of this exact system.
      </p>
    </div>
  </Section>
</Layout>
